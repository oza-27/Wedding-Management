# Copy to a local untracked .env file or configure user-secrets/environment variables.
# Use only a dedicated local database for tests: WeddingSaaS_Dev_Test.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=WeddingSaaS_Dev_Test;Username=postgres;Password=SET_LOCALLY
Jwt__Issuer=WeddingSaaS
Jwt__Audience=WeddingSaaS.Client
Jwt__SigningKey=SET_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES_LOCALLY
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30
Email__Provider=Smtp
Email__SenderName=Wedding SaaS
Email__SenderEmail=SET_LOCALLY
Email__FrontendBaseUrl=http://localhost:4200
Email__Smtp__Host=SET_LOCALLY
Email__Smtp__Port=587
Email__Smtp__EnableSsl=true
Email__Smtp__Username=SET_LOCALLY
Email__Smtp__Password=SET_LOCALLY
